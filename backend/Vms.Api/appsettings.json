{
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173"
    ]
  },
  "Jwt": {
    "Issuer": "vms-api",
    "Audience": "vms-web",
    "SigningKey": "development-only-signing-key-change-before-production-2026",
    "AccessTokenMinutes": 60
  },
  "CameraMonitoring": {
    "Enabled": true,
    "InitialDelaySeconds": 5,
    "IntervalSeconds": 15,
    "ProbeTimeoutSeconds": 5,
    "FfprobeExecutable": "ffprobe"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
