# Copy to .env only when you need to override these safe development defaults.
POSTGRES_DB=vms
POSTGRES_USER=vms
POSTGRES_PASSWORD=vms_dev_password
POSTGRES_PORT=5432

JWT_ISSUER=vms-api
JWT_AUDIENCE=vms-web
# Development-only example. Use a random 32+ character secret outside local use.
JWT_SIGNING_KEY=development-only-signing-key-change-before-production-2026

# Step 3 camera-health cadence and per-source FFprobe timeout.
CAMERA_MONITOR_INTERVAL_SECONDS=15
CAMERA_PROBE_TIMEOUT_SECONDS=5

API_PORT=8080
FRONTEND_PORT=3000
RTSP_PORT=8554
HLS_PORT=8888
MEDIAMTX_API_PORT=9997
MEDIAMTX_METRICS_PORT=9998

VITE_API_BASE_URL=http://localhost:8080
VITE_HLS_BASE_URL=http://localhost:8888
